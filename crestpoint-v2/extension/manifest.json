{
  "manifest_version": 3,
  "name": "Crestpoint Job Importer",
  "version": "1.0.0",
  "description": "Save jobs into Crestpoint Career Solutions.",

  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Save Job to Crestpoint"
  },

  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}